# Defaults to the local, deterministic Korean classroom interpreter.
PHYSIS_AI_PROVIDER=mock
# Keep environment-only defaults on Mock. A user can explicitly select an adapter per request.
PHYSIS_ALLOW_ENV_PROVIDER_DEFAULT=0

# Set a model id available from the selected provider. For Ollama, use a local model tag.
PHYSIS_AI_MODEL=

# Optional initial model id for each provider in Tutor settings.
PHYSIS_OPENAI_MODEL=
PHYSIS_ANTHROPIC_MODEL=
PHYSIS_OLLAMA_MODEL=
PHYSIS_COMPATIBLE_MODEL=

# OpenAI and Anthropic each use the corresponding server-side key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama server root. The adapter appends /api/chat.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat Completions-compatible API base including its version path, e.g. http://127.0.0.1:8001/v1
PHYSIS_COMPATIBLE_BASE_URL=
PHYSIS_COMPATIBLE_API_KEY=
